<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }}</title>
<style>
:root{color-scheme:light dark}body{max-width:1100px;margin:48px auto;padding:0 28px;font:16px/1.6 system-ui;background:#0b0f14;color:#fafafa}h1{font-size:42px;letter-spacing:-.04em}h2{padding-top:24px;border-top:1px solid #475569;color:#67e8f9}table{border-collapse:collapse;width:100%;font-size:13px;display:block;overflow:auto}td,th{border-bottom:1px solid #475569;padding:12px;text-align:left;font-variant-numeric:tabular-nums}code,pre{font-family:ui-monospace,monospace}pre{padding:20px;background:#17212d;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere}a{color:#67e8f9}blockquote{border-left:3px solid #0891b2;margin-left:0;padding:12px 20px;background:#17212d}p,td{overflow-wrap:anywhere}@media print{body{background:white;color:#111;margin:0;max-width:none;font-size:11pt}h2{color:#111;break-after:avoid}pre,blockquote{background:#eee}table{display:table}tr{break-inside:avoid}a{color:#111}h1{font-size:26pt}}
</style></head><body><main>{{ body }}</main></body></html>
